---
import "../styles/media-bar.css";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Copy from "./Copy.astro";
import Icon, { type BrandId } from "./Icon.astro";
import UiIcon from "./UiIcon.astro";

/*
 * A list-then-player container under the identity card, shared by
 * Antonio's podcasts (PodcastsPlayer, Spotify) and his YouTube playlist
 * (VideosPlayer). Like the Apple Music one (styles/media-bar.css): a small
 * label with the service's mark, then a collapsed bar with a few covers,
 * the title, the count and a down arrow. Opening it (which closes the
 * others: one open at a time) lists the items; picking one swaps the list
 * for the service's embed of it, with a way back and a link to it on the
 * service. Closing it or going back unloads the player, so nothing plays
 * out of sight. Behaviour: scripts/media-list.ts.
 */
export interface MediaItem {
  id: string;
  name: string;
  /** The line under the name (publisher, channel); none when empty. */
  meta?: string;
  link: string;
  image?: ImageMetadata | undefined;
}

interface Props {
  brand: BrandId;
  /** The service's name, read before the label by screen readers. */
  brandName: string;
  label: string;
  title: string;
  count: string;
  items: MediaItem[];
  /** 16:9 thumbnails and player (videos) instead of square covers. */
  wide?: boolean;
  /** The player's address; `{id}` is replaced by the picked item's. */
  embed: string;
  /** "key=value" added to the player's address in the dark theme. */
  dark?: string;
  /** The player frame's name; `{name}` is replaced by the item's. */
  playerTitle: string;
  back: string;
  /** The link under the player: to `href`, or else to the picked item. */
  more: { label: string; href?: string };
  /** After each item's name in the no-JS links. */
  listen: string;
  /** While the data is mock: the placeholder shown instead of a player. */
  mock?: string | undefined;
}

const {
  brand,
  brandName,
  label,
  title,
  count,
  items,
  wide = false,
  embed,
  dark,
  playerTitle,
  back,
  more,
  listen,
  mock,
} = Astro.props;
const rowWidth = wide ? 64 : 36;
---

<div class:list={["media", { wide }]}>
  <media-list
    data-embed={embed}
    data-dark={dark}
    data-title={playerTitle}
    data-mock={mock ? "" : undefined}
    data-more={more.href ? "fixed" : undefined}
  >
    <div class="media-glass">
      <p class="media-label">
        <Icon name={brand} size={11} />
        <span class="visually-hidden">{brandName} </span>
        {label}
      </p>
      <details class="media-details" name="side-media">
        <summary class="media-bar">
          <span class="item-stack" aria-hidden="true">
            {items
              .slice(0, 3)
              .map((item) =>
                item.image ? (
                  <Image
                    class="item-stack-cover"
                    src={item.image}
                    alt=""
                    width={wide ? 56 : 32}
                    height={32}
                    densities={[1, 2]}
                  />
                ) : (
                  <span class="item-stack-cover" />
                ),
              )}
          </span>
          <span class="media-text">
            <span class="media-name">{title}</span>
            <span class="item-count muted">{count}</span>
          </span>
          <span class="media-arrow" aria-hidden="true">
            <UiIcon name="chevron" size={16} strokeWidth={2} />
          </span>
        </summary>
        <div class="media-panel">
          <ul class="item-list">
            {items.map((item) => (
              <li>
                <button
                  type="button"
                  class="item-row"
                  data-id={item.id}
                  data-name={item.name}
                  data-link={item.link}
                >
                  {item.image ? (
                    <Image
                      class="item-cover"
                      src={item.image}
                      alt=""
                      width={rowWidth}
                      height={36}
                      densities={[1, 2]}
                    />
                  ) : (
                    <span class="item-cover" />
                  )}
                  <span class="item-meta">
                    <span class="item-name">{item.name}</span>
                    {item.meta && (
                      <span class="item-sub muted">{item.meta}</span>
                    )}
                  </span>
                  <span class="item-go" aria-hidden="true">
                    <UiIcon name="chevron" size={14} strokeWidth={2} />
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <div class="item-player" hidden>
            <button type="button" class="item-back">
              <UiIcon name="chevron" size={14} strokeWidth={2} />
              {back}
            </button>
            {mock ? (
              <p class="media-placeholder">
                <Copy text={mock} />
              </p>
            ) : (
              <>
                <iframe
                  title={playerTitle.replace("{name}", title)}
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                />
                <a class="item-more" href={more.href ?? items[0]?.link}>
                  {more.label}
                  <UiIcon name="external" size={12} strokeWidth={2} />
                </a>
              </>
            )}
          </div>
          <noscript>
            <ul>
              {items.map((item) => (
                <li>
                  <a href={item.link}>
                    {item.name}
                    <span class="visually-hidden"> ({listen})</span>
                  </a>
                </li>
              ))}
            </ul>
          </noscript>
        </div>
      </details>
    </div>
  </media-list>
</div>

<script>
  import "../scripts/media-list";
</script>

<style>
  media-list {
    display: block;
  }

  /* A few covers, overlapping, where the playlist bar has its one cover. */
  .item-stack {
    display: flex;
    flex: none;
    padding-left: 4px;
  }

  .item-stack :global(.item-stack-cover) {
    width: 32px;
    height: 32px;
    margin-left: -12px;
    border: 2px solid var(--surface);
    border-radius: 8px;
    background: var(--chip);
    object-fit: cover;
  }

  .item-stack :global(.item-stack-cover:first-child) {
    margin-left: 0;
  }

  .item-count {
    display: block;
    font-size: 0.75rem;
  }

  /*
   * Four rows and half of a fifth, then the list scrolls inside the
   * container (requested by Antonio), so it doesn't grow with every item.
   * The half row says there's more where scrollbars stay hidden (macOS).
   * A row is 55px at the default text size: the 36px-tall cover, or two
   * lines of text, plus padding.
   */
  .item-list {
    --item-row: 3.45rem;

    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: calc(var(--item-row) * 4.5 + 8px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .item-list[hidden] {
    display: none;
  }

  .item-row {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
    min-height: var(--touch);
    padding: 6px 8px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .item-row:is(:hover, :focus-visible) {
    background: var(--chip-glass);
  }

  .item-row:focus-visible,
  .item-back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .item-row :global(.item-cover) {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--chip);
    object-fit: cover;
  }

  .wide .item-row :global(.item-cover) {
    width: 64px;
    border-radius: 6px;
  }

  .item-meta {
    flex: 1;
    min-width: 0;
  }

  .item-name,
  .item-sub {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item-name {
    font-size: var(--text-small);
    font-weight: 500;
  }

  .item-sub {
    font-size: 0.75rem;
  }

  /* A right-pointing chevron: the shared one, turned. */
  .item-go {
    display: grid;
    flex: none;
    color: var(--muted);
    transform: rotate(-90deg);
  }

  .item-player {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .item-player[hidden] {
    display: none;
  }

  .item-back {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    align-self: flex-start;
    min-height: 32px;
    padding: 0 10px 0 4px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .item-back:hover {
    color: var(--fg);
  }

  .item-back :global(svg) {
    transform: rotate(90deg);
  }

  .item-more {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    align-self: center;
    min-height: 32px;
    padding: 0 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .item-more:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  iframe {
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
    border-radius: 12px;
  }

  .wide iframe {
    height: auto;
    aspect-ratio: 16 / 9;
  }
</style>
