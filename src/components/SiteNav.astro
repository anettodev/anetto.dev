---
import { localizedPath, t } from "../i18n";
import type { Locale } from "../i18n/locales";
import type { RouteKey } from "../i18n/routes";
import { PERSON } from "../lib/site";

/*
 * Phase 1 navigation: every link visible, no JavaScript. Phase 2 turns this
 * into the glass <site-island> with compact/expanded states and the
 * language pill; without JS it keeps this expanded form.
 */
interface Props {
  locale: Locale;
  route?: RouteKey | undefined;
}

const { locale, route } = Astro.props;
const ui = t(locale);
const items = ["about", "experiences", "projects", "blog"] as const;
---

<header class="site-nav">
  <nav class="pill" aria-label={ui.navLabel}>
    <a
      class="home"
      href={localizedPath(locale, "home")}
      aria-current={route === "home" ? "page" : undefined}
    >
      {PERSON.name}
    </a>
    <span class="divider" aria-hidden="true"></span>
    <ul class="links">
      {items.map((item) => (
        <li>
          <a
            href={localizedPath(locale, item)}
            aria-current={route === item ? "page" : undefined}
          >
            {ui.nav[item]}
          </a>
        </li>
      ))}
    </ul>
    <a class="hello" href={`mailto:${PERSON.email}`}>
      {ui.sayHello}
    </a>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 50;
    max-width: calc(100vw - 32px);
    transform: translateX(-50%);
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 52px;
    padding: 4px 4px 4px 22px;
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    font-size: 0.875rem;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .pill::-webkit-scrollbar {
    display: none;
  }

  a {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: var(--touch);
    border-radius: var(--radius-pill);
    text-decoration: none;
  }

  .home {
    font-weight: 600;
  }

  .divider {
    flex: none;
    width: 1px;
    height: 16px;
    margin: 0 10px;
    background: var(--hairline);
  }

  .links {
    display: flex;
    gap: 2px;
  }

  .links a {
    padding: 0 14px;
    color: var(--muted);
  }

  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--fg);
  }

  .links a[aria-current="page"] {
    background: var(--chip);
  }

  .hello {
    margin-left: 8px;
    padding: 0 18px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .hello:hover {
    color: var(--on-accent);
  }
</style>
