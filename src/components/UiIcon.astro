---
/* Stroke-style UI icons (spec §7, Icon). Paths match the design canvas. */
const PATHS = {
  menu: ["M4 9h16M4 15h16"],
  close: ["M6 6l12 12M18 6 6 18"],
  moon: ["M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"],
  sun: [
    "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z",
    "M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4",
  ],
  chevron: ["M6 9l6 6 6-6"],
  check: ["M5 12l5 5L20 7"],
  // Home lanes (feature cards).
  briefcase: [
    "M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z",
    "M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2",
    "M3 13h18",
  ],
  layers: ["M12 3 2 8l10 5 10-5-10-5z", "M2 12.5l10 5 10-5", "M2 17l10 5 10-5"],
  smartphone: [
    "M8.5 2h7A2.5 2.5 0 0 1 18 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 19.5v-15A2.5 2.5 0 0 1 8.5 2z",
    "M11 18h2",
  ],
} as const;

export type UiIconName = keyof typeof PATHS;

interface Props {
  name: UiIconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.8, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {PATHS[name].map((d) => (
    <path d={d} />
  ))}
</svg>
