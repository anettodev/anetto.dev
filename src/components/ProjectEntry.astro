---
import { Image } from "astro:assets";

import { t } from "../i18n";
import type { Locale } from "../i18n/locales";
import type { Project } from "../lib/content";
import Copy from "./Copy.astro";

/**
 * A product or system with its status (§5.4 Projects): device slot, status
 * pill, title, one line, stack, link. `compact` is the Home preview.
 */
interface Props {
  project: Project;
  locale: Locale;
  variant?: "full" | "compact";
  headingLevel?: 2 | 3;
}

const { project, locale, variant = "full", headingLevel = 2 } = Astro.props;
const ui = t(locale);
const Heading = `h${headingLevel}` as "h2" | "h3";
const screenPlaceholder = `[PLACEHOLDER: ${project.title} ${ui.screenPlaceholder}]`;
---

<article class:list={["project", variant]}>
  <div class="slot">
    <div class="device">
      {project.screen ? (
        <Image src={project.screen} alt="" widths={[230, 460]} sizes="230px" />
      ) : (
        <p class="screen-placeholder">
          <Copy text={screenPlaceholder} />
        </p>
      )}
    </div>
  </div>
  <div class="details">
    <p class:list={["status", project.status]}>{ui.status[project.status]}</p>
    <Heading class="title">{project.title}</Heading>
    <p class="description muted">
      <Copy text={project.description} />
    </p>
    <p class="label">{project.stack.join(" · ")}</p>
    {project.link && (
      <a class="more-link" href={project.link.href}>
        {project.link.label}
        <span aria-hidden="true">&nbsp;→</span>
      </a>
    )}
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    align-items: center;
  }

  .slot {
    display: flex;
    flex: 1 1 18rem;
    justify-content: center;
    padding: 48px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
  }

  .device {
    display: grid;
    place-items: center;
    width: 230px;
    aspect-ratio: 230 / 470;
    overflow: hidden;
    border: 10px solid var(--line-strong);
    border-radius: 44px;
    background: var(--chip);
  }

  .device :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .screen-placeholder {
    padding: 0 16px;
    font-size: var(--text-small);
    text-align: center;
  }

  .details {
    display: flex;
    flex: 999 1 20rem;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    min-width: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status.in-progress {
    color: var(--status);
  }

  .status.past {
    color: var(--muted);
  }

  .title {
    font-size: var(--text-title);
    line-height: 1;
  }

  .description {
    max-width: 34rem;
    line-height: 1.6;
  }

  /* Home preview: smaller slot, smaller title. */
  .compact {
    gap: 24px 40px;
  }

  .compact .slot {
    flex-basis: 12rem;
    padding: 28px 0;
  }

  .compact .device {
    width: 120px;
    border-width: 6px;
    border-radius: 26px;
  }

  .compact .screen-placeholder {
    padding: 0 6px;
    font-size: 0.6875rem;
  }

  .compact .title {
    font-size: var(--text-h2);
  }

  .compact .details {
    gap: 14px;
  }
</style>
