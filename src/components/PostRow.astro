---
import Copy from "./Copy.astro";

/** A piece of writing hosted elsewhere (§5.4 Blog). Without `href` it is a placeholder row. */
interface Props {
  title: string;
  source: string;
  year: string;
  href?: string | undefined;
}

const { title, source, year, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="post" href={href}>
  <span class="title">
    <Copy text={title} />
  </span>
  <span class="label">
    {source} · <Copy text={year} />
  </span>
</Tag>

<style>
  .post {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    justify-content: space-between;
    min-height: var(--touch);
    padding: 24px 0;
    text-decoration: none;
  }

  .title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  a.post:hover .title {
    color: var(--accent);
  }
</style>
