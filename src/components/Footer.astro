---
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";
import { FEED_PATH } from "../lib/notes-feed";
import { PERSON, REPO_URL, SOCIAL } from "../lib/site";
import Icon from "./Icon.astro";
import UiIcon from "./UiIcon.astro";

/*
 * One quiet row (Antonio's pick, 2026-10-09): the email, the profiles and
 * the notes' RSS feed on the left; the copyright and "Back to top" on the
 * right. On phones the identity card has scrolled away by the end of a
 * page, so this is where to reach Antonio or go back up. It wraps into two
 * rows on narrow screens. Above it, a note that the site is open source,
 * linking its GitHub repository (requested by Antonio;
 * moved above the row on 2026-10-09).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
// Computed at build time, never hard-coded (§5.4).
const year = new Date().getFullYear();
/*
 * The note as one HTML string: in markup, the line breaks a formatter adds
 * around the link would render as spaces ("GitHub ."). The UI strings are
 * escaped all the same.
 */
const escape = (text: string) =>
  text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
const [beforeLink = "", afterLink = ""] = ui.footer.openSource.split("{link}");
const note = `${escape(beforeLink)}<a href="${REPO_URL}" rel="noopener">${escape(ui.footer.repo)}</a>${escape(afterLink)}`;
---

<footer class="site-footer">
  <div class="footer-body">
    <p class="footer-note" set:html={note} />
    <div class="inner">
      <div class="reach">
        <a class="email" href={`mailto:${PERSON.email}`}>
          {PERSON.email}
        </a>
        <ul class="footer-links" aria-label={ui.card.profilesLabel}>
          {SOCIAL.map((profile) => (
            <li>
              <a
                href={profile.href}
                rel="me"
                aria-label={profile.label}
                title={profile.label}
              >
                <Icon name={profile.id} size={18} />
              </a>
            </li>
          ))}
          <li>
            <a
              href={FEED_PATH}
              type="application/rss+xml"
              target="_blank"
              rel="noopener"
              aria-label={ui.feed.label}
              title={ui.feed.hint}
            >
              <Icon name="rss" size={16} />
            </a>
          </li>
        </ul>
      </div>
      <div class="sign">
        <p class="label">
          © {year} {PERSON.name}
        </p>
        {/* "#top" is the top of the page by definition (HTML), with or without such an id. */}
        <a
          class="footer-top"
          href="#top"
          aria-label={ui.footer.top}
          title={ui.footer.top}
        >
          <UiIcon name="arrowUp" size={18} strokeWidth={1.9} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: var(--space-section) auto 0;
    padding: 0 var(--gutter);
  }

  /* The hairline and padding wrap the note and the row together. */
  .footer-body {
    padding: 48px 0;
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
  }

  .reach,
  .sign {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: 1.125rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
  }

  /* Icon links: quiet until hovered or focused, each a full touch target. */
  .footer-links a,
  .footer-top {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .footer-links a:is(:hover, :focus-visible),
  .footer-top:is(:hover, :focus-visible) {
    background: var(--chip);
    color: var(--fg);
  }

  .footer-top {
    border: 1px solid var(--line-strong);
  }

  /* The open-source note: small and muted, its link in the text colour. */
  .footer-note {
    max-width: 60ch;
    color: var(--muted);
    font-size: var(--text-small);
  }

  /* Injected with set:html, so the link needs :global(). */
  .footer-note :global(a) {
    color: var(--fg);
  }
</style>
