---
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";
import type { Project } from "../lib/content";
import CountBadge from "./CountBadge.astro";
import ProjectCards from "./ProjectCards.astro";
import UiIcon from "./UiIcon.astro";

/*
 * The Projects page's "Pinned" section (requested by Antonio): the pinned
 * projects in a horizontal carousel (ProjectCards' `carousel` layout), with
 * round arrows beside it, left and right, centred on its height, and one
 * dot per stop under it (scripts/project-carousel.ts). It moves on by
 * itself every 5 s and wraps from the last stop to the first. On narrow
 * columns the arrows give their room to the cards: swipe or use the dots.
 * Every control hides when all cards already fit (one pinned project), and
 * without JavaScript, when the row still scrolls by hand, swipe or keyboard
 * (it takes focus) and keeps its scrollbar.
 */
interface Props {
  projects: Project[];
  locale: Locale;
  id?: string;
}

const { projects, locale, id = "pinned" } = Astro.props;
const ui = t(locale);
---

<project-carousel class="block">
  <section aria-labelledby={id}>
    <div class="block-head">
      <h2 id={id}>
        {ui.projectsPage.pinned}
        <CountBadge
          count={projects.length}
          words={ui.projectsPage.count}
          locale={locale}
        />
      </h2>
    </div>
    <div class="stage">
      <button
        type="button"
        class="arrow needs-js"
        data-step="-1"
        aria-label={ui.projectsPage.prev}
        hidden
      >
        <UiIcon name="chevron" size={18} strokeWidth={2.2} class="left" />
      </button>
      <div class="track" role="group" aria-label={ui.projectsPage.carousel}>
        <ProjectCards
          projects={projects}
          locale={locale}
          headingLevel={3}
          layout="carousel"
        />
      </div>
      <button
        type="button"
        class="arrow needs-js"
        data-step="1"
        aria-label={ui.projectsPage.next}
        hidden
      >
        <UiIcon name="chevron" size={18} strokeWidth={2.2} class="right" />
      </button>
    </div>
    <div
      class="dots needs-js"
      role="group"
      aria-label={ui.projectsPage.dots}
      data-show={ui.projectsPage.show}
      hidden
    ></div>
  </section>
</project-carousel>

<script>
  import "../scripts/project-carousel";
</script>

<style>
  .block {
    display: block;
    margin-top: var(--space-section);
  }

  .block-head {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .block-head h2 {
    font-size: var(--text-h2);
  }

  /* Arrow, row, arrow; the arrows sit level with the row's middle. */
  .stage {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-top: 32px;
  }

  .track {
    flex: 1;
    min-width: 0;
  }

  .arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }

  .arrow:hover {
    background: var(--surface);
  }

  .arrow:active {
    transform: scale(0.94);
  }

  .arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .arrow[hidden],
  .dots[hidden] {
    display: none;
  }

  /* Narrow columns: the cards keep the room; swipe or use the dots. */
  @container (width < 40rem) {
    .arrow {
      display: none;
    }
  }

  /* The chevron points down; turned to point left and right. */
  .arrow :global(.left) {
    transform: rotate(90deg);
  }

  .arrow :global(.right) {
    transform: rotate(-90deg);
  }

  .dots {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
  }

  /*
   * 24px targets around an 8px dot; the current stop's dot is a dash in the
   * text colour (near-black or near-white with the theme, Antonio's
   * request). The others mix it half into the page (3.4:1 light, 4.6:1
   * dark; 3:1 is the floor for controls).
   */
  .dots :global(button) {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dots :global(button)::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 50%, var(--bg));
    transition:
      width 0.3s,
      background-color 0.3s;
  }

  .dots :global(button:hover)::before {
    background: var(--muted);
  }

  .dots :global(button[aria-current="true"])::before {
    width: 22px;
    background: var(--fg);
  }

  .dots :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .dots :global(button)::before {
      transition: none;
    }
  }
</style>
