---
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";
import { FEED_PATH } from "../lib/notes-feed";
import UiIcon from "./UiIcon.astro";

/*
 * The notes' RSS feed (requested by Antonio), in the Blog page's header: a
 * link that opens the feed in a new tab, as the browser shows it (Antonio's
 * choice: the raw feed, no styling). The tooltip says it opens a new tab,
 * as TL;DR's does. Sits in a .button-row, whose isolation the halo needs.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<a
  class="button with-icon"
  href={FEED_PATH}
  type="application/rss+xml"
  target="_blank"
  rel="noopener"
  title={ui.feed.hint}
>
  <UiIcon name="rss" size={16} strokeWidth={1.9} />
  {ui.feed.label}
  <UiIcon name="external" size={14} strokeWidth={2} />
</a>

<style>
  a {
    font-size: var(--text-small);
  }
</style>
