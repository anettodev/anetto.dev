---
import type { Locale } from "../i18n/locales";
import IdentityCardBody from "./IdentityCardBody.astro";
import IntroCard from "./IntroCard.astro";

/*
 * Docked identity card (spec §5.2). Sticky in the left column from 900px up;
 * at the top of the page, scrolling away, below that. On Home it is wrapped
 * by the intro card, which flips into it once per session (§8.1).
 */
interface Props {
  locale: Locale;
  intro?: boolean | undefined;
}

const { locale, intro = false } = Astro.props;
---

<aside class="identity" aria-labelledby="identity-name">
  {intro ? (
    <IntroCard locale={locale}>
      <IdentityCardBody locale={locale} />
    </IntroCard>
  ) : (
    <IdentityCardBody locale={locale} />
  )}
</aside>

<style>
  .identity {
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .identity {
      position: sticky;
      top: var(--nav-clearance);
      max-width: none;
      max-height: calc(100dvh - 120px);
      overflow-y: auto;
    }
  }
</style>
