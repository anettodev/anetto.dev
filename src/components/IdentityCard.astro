---
import { Picture } from "astro:assets";

import portrait from "../assets/portrait.jpeg";
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";
import { PERSON, SOCIAL } from "../lib/site";
import Icon from "./Icon.astro";

/*
 * Docked identity card (spec §5.2). Sticky in the left column from 900px up;
 * at the top of the page, scrolling away, below that. Phase 3 adds the intro
 * card that flips into this one on Home.
 */
interface Props {
  locale: Locale;
}

const ui = t(Astro.props.locale);
---

<aside class="identity" aria-labelledby="identity-name">
  <div class="portrait">
    <Picture
      src={portrait}
      alt={ui.card.portraitAlt}
      formats={["avif", "webp"]}
      widths={[184, 350]}
      sizes="184px"
      width={184}
      height={184}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="panel">
    <p class="name" id="identity-name">
      {PERSON.name}
    </p>
    <p class="role">{ui.card.role}</p>
    <p class="place muted">{ui.card.place}</p>
    <hr />
    <ul class="profiles" aria-label={ui.card.profilesLabel}>
      {SOCIAL.map((profile) => (
        <li>
          <a href={profile.href} rel="me" aria-label={profile.label}>
            <Icon name={profile.id} />
          </a>
        </li>
      ))}
    </ul>
    <a class="email" href={`mailto:${PERSON.email}`}>
      {PERSON.email}
    </a>
  </div>
</aside>

<style>
  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
  }

  .portrait :global(img) {
    width: 184px;
    height: 184px;
    border-radius: 50%;
    object-fit: cover;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
    text-align: center;
  }

  .name {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .role {
    font-weight: 500;
  }

  .place {
    font-size: var(--text-small);
  }

  hr {
    margin: 16px 0;
  }

  .profiles {
    display: flex;
    gap: 8px;
  }

  .profiles a {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: 50%;
    background: var(--chip);
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin-top: 4px;
    font-size: var(--text-small);
  }

  @media (min-width: 900px) {
    .identity {
      position: sticky;
      top: var(--nav-clearance);
      max-height: calc(100dvh - 120px);
      overflow-y: auto;
      max-width: none;
    }
  }

  /* Short desktop viewports: compact variant so the sticky card never overflows (§5.2). */
  @media (min-width: 900px) and (max-height: 819px) {
    .identity {
      gap: 12px;
    }

    .portrait :global(img) {
      width: 120px;
      height: 120px;
    }

    .panel {
      padding: 18px;
    }

    hr {
      margin: 10px 0;
    }
  }
</style>
