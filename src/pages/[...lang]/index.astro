---
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import GitHubActivity from "../../components/GitHubActivity.astro";
import CountBadge from "../../components/CountBadge.astro";
import TechStack from "../../components/TechStack.astro";
import { localeStaticPaths, localizedPath, t } from "../../i18n";
import type { Locale } from "../../i18n/locales";
import Page from "../../layouts/Page.astro";
import { getCompanies, getPage } from "../../lib/content";
import { TECH_STACK } from "../../lib/tech-stack";
import { PERSON } from "../../lib/site";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = await getPage(locale, "home");
const { positioning, lanes, previews } = home.data;
const companies = await getCompanies(home.lang);
const ui = t(locale);

/*
 * Lanes render as feature cards (§6.7, decision #7): one gradient and icon
 * each. Antonio's lanes: about him (a person), his current role (a
 * briefcase), his latest project (an iPhone: Nutria is an iOS app).
 */
const LANE_LOOK = [
  { icon: "user", gradient: "pink" },
  { icon: "briefcase", gradient: "cyan" },
  { icon: "smartphone", gradient: "violet" },
] as const;
---

<Page
  locale={locale}
  route="home"
  description={home.data.description}
  contentLang={home.lang}
  intro
>
  <!--
    The greeting says the name (requested by Antonio). Copy without it would
    get the name as a visually hidden prefix, so screen readers still hear it.
  -->
  <h1 class="positioning">
    {!positioning.join(" ").includes(PERSON.name) && (
      <span class="visually-hidden">{PERSON.name}. </span>
    )}
    {positioning.map((clause, index) => (
      <>
        <span class:list={["clause", { muted: index > 0 }]}>
          {clause
            .split(/(👋)/u)
            .map((part) =>
              part === "👋" ? <span class="wave">{part}</span> : part,
            )}
        </span>{" "}
      </>
    ))}
  </h1>

  <div class="lanes">
    {lanes.map((lane, index) => (
      <FeatureCard
        {...LANE_LOOK[index % LANE_LOOK.length]!}
        index={index}
        label={`${lane.number} · ${lane.label}`}
        title={lane.title}
        text={lane.text}
        href={localizedPath(locale, lane.route)}
        linkLabel={lane.linkLabel}
      />
    ))}
  </div>

  <section class="preview" aria-labelledby="preview-experiences">
    <div class="preview-head">
      <h2 id="preview-experiences">{previews.experiences.title}</h2>
      <a class="more-link" href={localizedPath(locale, "experiences")}>
        {previews.experiences.linkLabel}
        <span aria-hidden="true">&nbsp;→</span>
      </a>
    </div>
    {/* The latest three employers (requested by Antonio); the rest are on Experiences. */}
    <ExperienceTimeline
      companies={companies.slice(0, 3)}
      locale={locale}
      openFirst={false}
      more={{
        count: companies.length - 3,
        href: localizedPath(locale, "experiences"),
      }}
    />
  </section>

  {/* After Last Experiences (requested by Antonio); also on About. */}
  <section class="preview" aria-labelledby="preview-tech">
    <div class="preview-head">
      <h2 id="preview-tech">
        {ui.tech.title}
        <CountBadge
          count={TECH_STACK.length}
          words={ui.tech.count}
          locale={locale}
        />
      </h2>
      {/* To About, which shows the list too (requested by Antonio). */}
      <a class="more-link" href={localizedPath(locale, "about")}>
        {previews.tech.linkLabel}
        <span aria-hidden="true">&nbsp;→</span>
      </a>
    </div>
    <TechStack locale={locale} labelledBy="preview-tech" />
  </section>

  {/* The last section on Home (requested by Antonio). */}
  <GitHubActivity locale={locale} />
</Page>

<script>
  import { INTRO_REVEAL_EVENT } from "../../scripts/prefs";

  /* The wave starts when the intro reveals the page (see .wave below). */
  document.addEventListener(
    INTRO_REVEAL_EVENT,
    () => document.querySelector(".wave")?.classList.add("is-on"),
    { once: true },
  );
</script>

<style>
  /* Just the greeting (Antonio's change), as large as the other pages' headlines. */
  .positioning {
    font-size: calc(var(--text-h1) - 2px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .clause {
    display: block;
  }

  /*
   * The greeting's 👋 waves once as the page appears (requested by Antonio).
   * During Home's intro the page sits under the intro card, so the wave
   * waits, paused, until the intro reveals the page (the script below adds
   * .is-on). Not at all with reduced motion.
   */
  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 1.8s ease-in-out 0.4s both;
  }

  :global(:root[data-intro="play"]) .wave:not(.is-on) {
    animation-play-state: paused;
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      transform: rotate(0deg);
    }
    10%,
    30% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }

  .lanes {
    display: grid;
    gap: 24px;
    margin-top: calc(var(--space-section) * 0.6);
  }

  /* Three cards in a row once the content column (the <main> container) is wide enough; square there (§6.7). */
  @container (min-width: 45rem) {
    .lanes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    /*
     * Square, but free to grow taller when the copy needs it (min-height:
     * auto). min-width: 0 stops that taller height from being turned back
     * into a minimum width through the aspect ratio.
     */
    .lanes :global(.card) {
      aspect-ratio: 1;
      min-width: 0;
      min-height: auto;
    }
  }

  .preview {
    margin-top: var(--space-section);
  }

  .preview-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .preview-head h2 {
    font-size: var(--text-h2);
  }

  .preview > :global(.timeline),
  .preview > :global(.tech-grid),
  .preview > :global(.tech-empty) {
    margin-top: 32px;
  }
</style>
